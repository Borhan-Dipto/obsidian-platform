{
  "name": "obsidian-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:critical && npm run test:integration",
    "test:critical": "node --test tests/critical/*.test.mjs",
    "security:secrets": "node scripts/ci/scan-secrets.mjs",
    "ci:verify": "npm run security:secrets && npm run lint && npm test && npm run build && npm audit --omit=dev",
    "test:integration": "node --import ./tests/helpers/register-server-module-loader.mjs --test tests/integration/*.test.mjs"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.6.24",
    "bcryptjs": "^3.0.2",
    "better-auth": "^1.6.24",
    "cloudinary": "^2.10.0",
    "mongodb": "6.20.0",
    "next": "16.2.11",
    "postcss": "8.5.23",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  },
  "engines": {
    "node": "24.x"
  }
}
